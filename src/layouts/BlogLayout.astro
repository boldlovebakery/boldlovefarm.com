---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { formatPostDate } from "../lib/blog.js";
const { post } = Astro.props;
const { title, description, publishDate, updatedDate, draft, featureImage, featureImageAlt } = post.data;
---
<BaseLayout title={`${title} | Bold Love Farm & Bakery`} description={description} article socialImage={featureImage?.src} socialImageAlt={featureImageAlt} draft={draft}>
  <main class="page content-page">
    <div class="content-layout">
      <article class="panel content-panel">
        <SiteHeader currentPage="blog" />
        <header class="blog-heading">
          <a class="text-link" href="/blog/">Back to the blog</a>
          {draft && <span class="draft-label">Draft — local preview</span>}
          <h1 class="page-title">{title}</h1>
          <div class="blog-meta">
            <time datetime={publishDate.toISOString()}>{formatPostDate(publishDate)}</time>
            {updatedDate && <span>Updated <time datetime={updatedDate.toISOString()}>{formatPostDate(updatedDate)}</time></span>}
          </div>
          {featureImage && <Image src={featureImage} alt={featureImageAlt} width={1200} class="blog-feature" loading="eager" />}
        </header>
        <div class="blog-prose"><slot /></div>
        <div class="blog-actions">
          <a class="primary-cta" href="https://grownby.com/farms/bold-love-farm-bakery/shop" target="_blank" rel="noopener noreferrer">Shop Bold Love Online</a>
          <a class="text-link" href="/blog/">More from the blog</a>
        </div>
        <SiteFooter />
      </article>
    </div>
  </main>
</BaseLayout>
