---
const shopUrl = "https://grownby.com/farms/bold-love-farm-bakery/shop";
---

<footer class="site-footer" aria-label="Site footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <div class="footer-title">Bold Love Farm &amp; Bakery</div>
      <p class="footer-copy">Local food grown, baked, and prepared with care.</p>
    </div>
    <a
      class="footer-link"
      href={shopUrl}
      target="_blank"
      rel="noopener noreferrer">Shop Online</a
    >
    <div class="footer-cert">
      <span class="organic-badge">
        <img
          src="/usda-organic-logo.gif"
          alt="USDA Organic seal"
          width="84"
          height="84"
        />
      </span>
      <div class="footer-cert-copy">
        <div class="footer-cert-title">USDA Certified Organic</div>
      </div>
    </div>
  </div>
  <div class="footer-meta">
    <p class="footer-note">&copy; 2026 Bold Love Farm &amp; Bakery</p>
    <p class="footer-community">Proud member of the Mount Airy, Maryland community.</p>
  </div>
</footer>
